{% extends 'base.html.twig' %}

{% block content1 %}

    <h2>{{ 'dashboard.header'|trans }}</h2>
    
    {# Show tables side-by-side #}
    <div class="row">
        {# Open cases table #}
        <div class="col-lg-6">
            <h3>{{ 'dashboard.open_cases'|trans }}</h3>

            <table class="table" id="open_cases">    
                <thead>
                    <tr>
                        <th class="col-md-2 col-sm-2">{{ 'case.attr.case_id' | trans }}</th>
                        <th class="col-md-1 col-sm-1">{{ 'case.attr.secrecy' | trans }}</th>
                        <th class="col-md-7 col-sm-7">{{ 'case.attr.description' | trans }}</th>
                        <th class="col-md-2 col-sm-2">{{ 'case.attr.opened_on' | trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for case in recentCases %}
                    <tr>
                        <td>{{ case.getCaseId }}</td>
                        <td>
                            <span class="label label-{{ case.getSecrecy.bootstrapColor }}">
                            {{ case.getSecrecy | trans}}
                            </span>
                        </td>
                        <td><a href="{{ path('detail_case', {'id': case.getCaseId}) }}">{{ case.getDescription | nl2br}}</a></td>
                        <td>{{ case.getOpenedOn|date('d.m.y H:i') }}</td>
                    </tr>
                {% else %}
                {% endfor %}
                </tbody>
            </table>
        </div>

        {# Reserved objects table #}
        <div class="col-lg-6">
            <h3>{{ 'dashboard.reserved_assets' | trans }}</h3>

            <table class="table" id="reserved_objekts">
                <thead>
                    <tr>
                        <th class="col-md-2 col-sm-2">{{ 'asset.attr.barcode'|trans }}</th>
                        <th class="col-md-2 col-sm-2">{{ 'asset.attr.category'|trans }}</th>
                        <th class="col-md-7 col-sm-7">{{ 'asset.attr.name'|trans }}</th>
                        <th class="col-md-1 col-sm-1">{{ 'form.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for asset in reservedAssets %}  
                    <tr>
                        <td style='font-family: courier;font-size: large'>{{ asset.getBarcode }}</td>
                        <td>
                            <span class="label label-{{ asset.getCategory.bootstrapColor }}">
                                {{ asset.getCategory | trans}}
                            </span>
                        </td>
                        <td>
                            <a href='{{ path('details_asset', {'id': asset.getBarcode}) }}'>{{ asset.getName }}<a/>
                        </td>
                        <td>
                            <a href='{{ path("unreserve_asset", {'id': asset.getBarcode })}}' data-toggle="tooltip" data-placement="top" title="{{ 'asset.actions.unreserve' | trans }}">
                                <span class="glyphicon glyphicon-remove"></span>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block context %}
    <a href='{{ path('NutzerPasswordAenderung') }}'>{{ 'user.actions.change_password'|trans }}</a><br>
    <a href='{{ path('Nutzerprofil') }}'>{{ 'user.actions.profile'|trans }}</a><br>
    <a href='{{ path('NutzerAenderung') }}'>{{ 'user.actions.edit_profile'|trans }}</a><br>
    {% if is_granted('ROLE_ADMIN') %}
             <a href='{{ path('Nutzerhinzufuegen') }}'>{{ 'user.actions.add'|trans }} </a><br>
             <a href='{{ path('usersummary') }}'>{{ 'user.actions.show'|trans }} </a><br>
    {% endif %}
    <a href='{{ path('change_language') }}'>{{ 'user.actions.change_language'|trans }} </a><br>
{% endblock %}


