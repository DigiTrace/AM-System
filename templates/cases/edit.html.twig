{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_3_layout.html.twig' %} 
{% block content1 %}
    <h2>{{ 'case.edit.header' | trans({'%case%': case.getCaseId}) }}</h2>
    {{ include('messages.html.twig') }}
   
    {{ form_start(form) }}
        <div class="row">
            <div class='col-sm-8'>
                {{ form_row(form.caseId) }}
            </div>

            <div class='col-sm-4'>
                {{ form_row(form.secrecy) }}
            </div>
        </div>

        <div class="row">
            <div class="col-sm-8">
                {{ form_row(form.closedOn) }}
            </div>
            <div class="col-sm-4">
                {{ form_row(form.active) }}
            </div>
        </div>
        
        <div class="row">
            <div class='col-sm-12'>
                {{ form_row(form.description) }}
            </div>            
        </div>
            
        <div class="row">
            <div class='col-sm-4'>
                {{ form_widget(form.save) }}
            </div>
        </div>

    {{ form_end(form, {render_rest: true}) }}
{% endblock %}

{% block stylesheets %}
{% endblock %}
