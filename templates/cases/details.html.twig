{% extends 'base.html.twig' %}

{% block content1 %}
    

    <h2>{% trans with {'%context%': fall.getCaseId} %}case.details.page.header %context%{% endtrans %}</h2>
    {{ include('messages.html.twig') }}
    
    <div class="cotainer-fluid">
        <h3>{{ 'case_current_state' | trans }}</h3>
        <table class="table">
            <tr>
                <td>{{ 'case.details.page.case_id' | trans }}</td>
                <td>{{ fall.getCaseId }}</td>
            </tr>

            <tr>
               <td>{{ 'case.details.page.description' | trans }}</td>
               <td>{{  fall.getDescription | nl2br}}</td>
            </tr>
            <tr>
                <td>{{ 'case.details.page.active' | trans }}</td>
                <td>
                    {% if fall.isActive %} {{ 'yes' | trans }}
                    {% else %} {{ 'no' | trans }}
                    {% endif %}
                </td>
             </tr>
             <tr>
               <td>{{ 'case.details.page.secrecy' | trans }}</td>
               <td>{{ fall.getSecrecy | trans }}</td>
             </tr>
             <tr>
                <td>{{ 'case.details.page.opened_on' | trans }}</td>
                <td>{{ fall.getOpenedOn|date('d.m.y H:i') }}</td>
            </tr>
        </table>
    </div>
            
 {% endblock %}
 {% block content2 %}
       
    <h3>{{ 'container_listed_assets' | trans }}</h3>
    <table class="table">
     <thead>
       <tr>
         <th>{{ 'desc.oid' | trans }}</th>
         <th>{{ 'desc.name' | trans }}</th>
         <th>{{ 'desc.lstatus' | trans }}</th>
         <th>{{ 'desc.last.action.done' | trans }}</th>
         <th>{{ 'desc.container' | trans }}</th>
       </tr>
     </thead>
     <tbody>

        {% for asset in fall.getAssets %}

         <tr style="cursor:pointer" onclick="window.location.href='{{ path('details_asset', {'id': asset.barcode}) }}'">
            <td style='font-family: courier;font-size: large'>
                <a href="{{ path('details_asset', {'id': asset.barcode}) }}">
                {{ asset.barcode }}
                </a>
            </td>
            <td>
                <a href="{{ path('details_asset', {'id': asset.barcode}) }}">
                    {{ asset.getName }}
                </a>
            </td>
            <td>{{ asset.state | trans }}</td>
            <td>{{ asset.lastUpdatePerformedOn | date('d.m.y H:i') }}</td>
            <td>
                {% if asset.location == false %}
                /
                {% else %}
                <a href='{{ path('details_asset', {'id': asset.location.barcode}) }}' >{{ asset.location.barcode }} | {{ asset.location.getName }} </a></td>
                {% endif %}
            </td>
       </tr>
       {% endfor %}
     </tbody>
  </table>
     
     
     <br>
     <br>
     <br>
     
     
     
    <h3>{{ 'case_listed_history_assets' | trans }}</h3>
    <table class="table">
     <thead>
       <tr>
         <th>{{ 'desc.oid' | trans }}</th>
         <th>{{ 'desc.name' | trans }}</th>
         <th>{{ 'desc.lstatus' | trans }}</th>
         <th>{{ 'desc.last.action.done' | trans }}</th>
         <th>{{ 'desc.container' | trans }}</th>
       </tr>
     </thead>
     <tbody>
         {% for history_asset in history_assets %}

         <tr style="cursor:pointer" onclick="window.location.href='{{ path('details_asset', {'id': history_asset.barcode}) }}'">
            <td style='font-family: courier;font-size: large'>
                <a href="{{ path('details_asset', {'id': history_asset.barcode}) }}">
                {{ history_asset.barcode }}
                </a>
            </td>
            <td>
                <a href="{{ path('details_asset', {'id': history_asset.barcode}) }}">
                    {{ history_asset.name }}
                </a>
            </td>
            <td>{{ history_asset.state | trans }}</td>
            <td>{{ history_asset.lastUpdatePerformedOn | date('d.m.y H:i') }}</td>
            <td>
                {% if history_asset.location == false %}
                /
                {% else %}
                <a href='{{ path('details_asset', {'id': history_asset.location}) }}' >{{ history_asset.location }} | {{ history_asset.name }} </a></td>
                {% endif %}
            </td>
       </tr>
       {% endfor %}
     </tbody>
  </table>
     
       
              {% trans with {'%cdate%': "now"|date('d.m.y'),'%ctime%':"now"| date('H:i')  } %}report has been made at %cdate% %ctime%{% endtrans %}
{% endblock %}

{% block stylesheets %}
{% endblock %}


{% block context %}
    <a onclick="window.print()"> <span class="glyphicon glyphicon-print"></span> {{ 'action.print' | trans }}</a><br>
    <a href='{{ path("update_case",{id:fall.getCaseId})}}'> <span class="glyphicon glyphicon-pencil"></span> {{ 'action.update.case' | trans }}</a><br>
    <a href='{{ path("download_case_word",{id:fall.getCaseId})}}'> <span class="glyphicon glyphicon-download"></span> {{ 'action.download.word.case' | trans }}</a><br>
{% endblock %}
