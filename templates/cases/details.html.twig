{% extends 'base.html.twig' %}

{% block content1 %}
    
    <h2>{{ 'case.details.header' | trans({'%case%': case.getCaseId}) }}</h2>
    {{ include('messages.html.twig') }}
    
    <div class="cotainer-fluid">
        <h3>{{ 'case.details.summary' | trans }}</h3>
        <table class="table">
            <tr>
                <td>{{ 'case.attr.case_id' | trans }}</td>
                <td>{{ case.getCaseId }}</td>
            </tr>

            <tr>
                <td>{{ 'case.attr.description' | trans }}</td>
                <td>{{  case.getDescription | nl2br}}</td>
            </tr>
            <tr>
                <td>{{ 'case.details.active' | trans }}</td>
                <td>
                    {% if case.isActive %} {{ 'yes' | trans }}
                    {% else %} {{ 'no' | trans }}
                    {% endif %}
                </td>
             </tr>
             <tr>
                <td>{{ 'case.attr.secrecy' | trans }}</td>
                <td>
                    <span class="label label-{{ case.getSecrecy.bootstrapColor }}">
                    {{ case.getSecrecy | trans}}
                    </span>
                </td>
             </tr>
             <tr>
                <td>{{ 'case.details.opened_on' | trans }}</td>
                <td>{{ case.getOpenedOn | date('d.m.y H:i') }}</td>
            </tr>
        </table>
    </div>
            
 {% endblock %}
 {% block content2 %}
       
    <h3>{{ 'case.details.associated_assets' | trans }}</h3>
    <table class="table">
     <thead>
       <tr>
         <th>{{ 'asset.attr.barcode' | trans }}</th>
         <th>{{ 'asset.attr.name' | trans }}</th>
         <th>{{ 'asset.attr.state' | trans }}</th>
         <th>{{ 'asset.attr.last_update_performed_on' | trans }}</th>
         <th>{{ 'asset.attr.location' | trans }}</th>
       </tr>
     </thead>
     <tbody>

        {% for asset in case.getAssets %}

         <tr style="cursor:pointer" onclick="window.location.href='{{ path('details_asset', {'id': asset.barcode}) }}'">
            <td style='font-family: courier;font-size: large'>
                <a href="{{ path('details_asset', {'id': asset.barcode}) }}">
                    {{ asset.barcode }}
                </a>
            </td>
            <td>
                <a href="{{ path('details_asset', {'id': asset.barcode}) }}">
                    {{ asset.getName }}
                </a>
            </td>
            <td>{{ asset.state | trans }}</td>
            <td>{{ asset.lastUpdatePerformedOn | date('d.m.y H:i') }}</td>
            <td>
                {% if asset.location == false %}
                /
                {% else %}
                <a href='{{ path('details_asset', {'id': asset.location.barcode}) }}' >{{ asset.location.barcode }} | {{ asset.location.getName }} </a></td>
                {% endif %}
            </td>
       </tr>
       {% endfor %}
     </tbody>
  </table>
     
     
     <br>
     <br>
     <br>
     
     
     
    <h3>{{ 'case.details.former_associated_assets' | trans }}</h3>
    <table class="table">
     <thead>
       <tr>
            <th>{{ 'asset.attr.barcode' | trans }}</th>
            <th>{{ 'asset.attr.name' | trans }}</th>
            <th>{{ 'asset.attr.state' | trans }}</th>
            <th>{{ 'asset.attr.last_update_performed_on' | trans }}</th>
            <th>{{ 'asset.attr.location' | trans }}</th>
       </tr>
     </thead>
     <tbody>
         {% for history_asset in history_assets %}

         <tr style="cursor:pointer" onclick="window.location.href='{{ path('details_asset', {'id': history_asset.barcode}) }}'">
            <td style='font-family: courier;font-size: large'>
                <a href="{{ path('details_asset', {'id': history_asset.barcode}) }}">
                {{ history_asset.barcode }}
                </a>
            </td>
            <td>
                <a href="{{ path('details_asset', {'id': history_asset.barcode}) }}">
                    {{ history_asset.name }}
                </a>
            </td>
            <td>{{ history_asset.state | trans }}</td>
            <td>{{ history_asset.lastUpdatePerformedOn | date('d.m.y H:i') }}</td>
            <td>
                {% if history_asset.location == false %}
                /
                {% else %}
                <a href='{{ path('details_asset', {'id': history_asset.location}) }}' >{{ history_asset.location }} | {{ history_asset.name }} </a></td>
                {% endif %}
            </td>
       </tr>
       {% endfor %}
     </tbody>
  </table>
{{ 'report_from' | trans({'%time%' : 'now'|date('d.m.y H:i')}) }}
{% endblock %}

{% block stylesheets %}
{% endblock %}


{% block context %}
    <a onclick="window.print()"> <span class="glyphicon glyphicon-print"></span> {{ 'case.actions.print' | trans }}</a><br>
    <a href='{{ path("update_case",{id:case.getCaseId})}}'> <span class="glyphicon glyphicon-pencil"></span> {{ 'case.actions.edit' | trans }}</a><br>
    <a href='{{ path("download_case_word",{id:case.getCaseId})}}'> <span class="glyphicon glyphicon-download"></span> {{ 'case.actions.download_word' | trans }}</a><br>
{% endblock %}
