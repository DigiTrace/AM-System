{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_3_layout.html.twig' %}
{% block content1 %}

    <div class="row">
        <div class="col-sm-4">
            <h2>{{ 'case.search.page.header' | trans }}</h2>
        </div>
        <div class="col-sm-8" style="margin-top:7px">
            {{ form_start(form) }}
            {{ form_row(form.search) }}
            {{ form_row(form.limit) }}
            {{ form_end(form) }}
        </div>
    </div>
    {{ include('messages.html.twig') }}

    <table class="table">

        {% if pagination.getDirection == "desc" %} {% set arrow = '<span class="glyphicon glyphicon-arrow-down"></span>' %}
        {% elseif pagination.getDirection == "asc" %}  {% set arrow = '<span class="glyphicon glyphicon-arrow-up"></span>' %}
        {% endif %}

        <thead>
            <tr>
                <th class="col-md-2 col-sm-2">{{ knp_pagination_sortable(pagination, 'case.search.page.case_id'|trans, 'caseFile.caseId') }}
                    {% if pagination.isSorted('caseFile.caseId') %}
                    {{ arrow | raw}}
                    {% endif %}
                </th>
                <th class="col-md-1 col-sm-1">{{ 'case.search.page.secrecy' | trans }}</th>
                <th class="col-md-7 col-sm-7">{{ 'case.search.page.description' | trans }}</th>
                <th class="col-md-2 col-sm-2">{{ knp_pagination_sortable(pagination, 'case.search.page.opened_on'|trans, 'caseFile.openedOn') }}
                    {% if pagination.isSorted('caseFile.openedOn') %}
                    {{ arrow | raw}}
                    {% endif %}
                </th>
            </tr>
        </thead>
        <tbody>
        {% for case in pagination %}
            <tr {{ case.isActive ? '' : 'class="active"' }}>
                <td>
                {% if case.isActive %}
                    {{ case.getCaseId }}
                {% else %}
                    <s>{{ case.getCaseId }}</s>
                {% endif %}
                </td>
                <td>
                    <span class="label label-{{ case.getSecrecy.bootstrapColor }}">
                    {{ case.getSecrecy | trans}}
                    </span>
                </td>
                <td><a href="{{ path('detail_case', {'id': case.getCaseId}) }}">{{ case.getDescription | nl2br}}</a></td>
                <td>{{ case.getOpenedOn|date('d.m.y H:i') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>



{# total items count #}
<div class="count">
    {{ pagination.getTotalItemCount }} {{ 'entrys.found' | trans }}
</div>

{# display navigation #}
<div class="navigation">
    {{ knp_pagination_render(pagination) }}
</div>

{% endblock %}

{% block context %}
    <a href="{{ path("add_case") }}"><span class="glyphicon glyphicon-pencil"></span> {{ 'add_new_case' | trans }} </a><br>
    <a href="{{ path("search_cases_faq") }}"><span class="glyphicon glyphicon-question-sign"></span> {{ 'action.case.faq.search' | trans }}</a> <br>
{% endblock %}


{% block searchbar %}

{% endblock %}
