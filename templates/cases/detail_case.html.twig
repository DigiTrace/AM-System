{% extends 'base.html.twig' %}

{% block content1 %}
    
    {% for label, messages in app.flashes %}
         {% for message in messages %}
             <div class="alert alert-{{ label }}">
                 {{ message | trans | nl2br}}
             </div>
         {% endfor %}
     {% endfor %}
    
    <h2>{% trans with {'%context%': fall.getCaseId} %}case_details %context%{% endtrans %}</h2>

        <h3>{% trans %}case_current_state{% endtrans %}</h3>
         <table class="table">
             <tr>
                 <td>{% trans %}case_id{% endtrans %}</td>
                 <td>{{ fall.getCaseId }}</td>
             </tr>

             <tr>
               <td>{% trans %}case_desc{% endtrans %}</td>
               <td>{{  fall.getDescription | nl2br}}</td>
             </tr>
             <tr>
               <td>{% trans %}case_isactiv{% endtrans %}</td>
               <td>
                   {% if fall.isActive == true%}
                    Ja
                   {% else %}
                    nein
                    {% endif %}
               </td>
             </tr>
             <tr>
               <td>{% trans %}case_dos{% endtrans %}</td>
               <td>
                   {% if fall.getSecrecy == ""%}
                        {% trans %}dos_not_set{% endtrans %}
                   {% else %}
                       <span 
                        {% if fall.getSecrecy == "DOS_PUBLIC"%}
                            class="label label-success"
                        {% elseif fall.getSecrecy == "DOS_INTERNAL"%}
                            class="label label-primary"
                        {% elseif fall.getSecrecy == "DOS_CONFIDENTIAL"%}
                            class="label label-warning"
                        {% elseif fall.getSecrecy == "DOS_SECRET"%}
                            class="label label-danger"
                       {% endif %}
                       >
                        {{ fall.getSecrecy | trans}}   
                       </span>
                   {% endif %}
                </td>
             </tr>
             <tr>
                 <td>{% trans %}case_timestamp{% endtrans %}</td>
                 <td>{{ fall.getOpenedOn|date('d.m.y H:i') }}</td>
             </tr>
         </table>
            
 {% endblock %}
 {% block content2 %}
       
    <h3>{% trans %}container_listed_assets{% endtrans %}</h3>
    <table class="table">
     <thead>
       <tr>
         <th>{% trans %}desc.oid{% endtrans %}</th>
         <th>{% trans %}desc.name{% endtrans %}</th>
         <th>{% trans %}desc.lstatus{% endtrans %}</th>
         <th>{% trans %}desc.last.action.done{% endtrans %}</th>
         <th>{% trans %}desc.container{% endtrans %}</th>
       </tr>
     </thead>
     <tbody>

        {% for asset in fall.getAssets %}

         <tr style="cursor:pointer" onclick="window.location.href='{{ path('details_asset', {'id': asset.barcode}) }}'">
            <td style='font-family: courier;font-size: large'>
                <a href="{{ path('details_asset', {'id': asset.barcode}) }}">
                {{ asset.barcode }}
                </a>
            </td>
            <td>
                <a href="{{ path('details_asset', {'id': asset.barcode}) }}">
                    {{ asset.getName }}
                </a>
            </td>
            <td>{{ asset.state | trans }}</td>
            <td>{{ asset.lastUpdatePerformedOn | date('d.m.y H:i') }}</td>
            <td>
                {% if asset.location == false %}
                /
                {% else %}
                <a href='{{ path('details_asset', {'id': asset.location.barcode}) }}' >{{ asset.location.barcode }} | {{ asset.location.getName }} </a></td>
                {% endif %}
            </td>
       </tr>
       {% endfor %}
     </tbody>
  </table>
     
     
     <br>
     <br>
     <br>
     
     
     
    <h3>{% trans %}case_listed_history_assets{% endtrans %}</h3>
    <table class="table">
     <thead>
       <tr>
         <th>{% trans %}desc.oid{% endtrans %}</th>
         <th>{% trans %}desc.name{% endtrans %}</th>
         <th>{% trans %}desc.lstatus{% endtrans %}</th>
         <th>{% trans %}desc.last.action.done{% endtrans %}</th>
         <th>{% trans %}desc.container{% endtrans %}</th>
       </tr>
     </thead>
     <tbody>
         {% for history_asset in history_assets %}

         <tr style="cursor:pointer" onclick="window.location.href='{{ path('details_asset', {'id': history_asset.barcode}) }}'">
            <td style='font-family: courier;font-size: large'>
                <a href="{{ path('details_asset', {'id': history_asset.barcode}) }}">
                {{ history_asset.barcode }}
                </a>
            </td>
            <td>
                <a href="{{ path('details_asset', {'id': history_asset.barcode}) }}">
                    {{ history_asset.name }}
                </a>
            </td>
            <td>{{ history_asset.state | trans }}</td>
            <td>{{ history_asset.lastUpdatePerformedOn | date('d.m.y H:i') }}</td>
            <td>
                {% if history_asset.location == false %}
                /
                {% else %}
                <a href='{{ path('details_asset', {'id': history_asset.location}) }}' >{{ history_asset.location }} | {{ history_asset.name }} </a></td>
                {% endif %}
            </td>
       </tr>
       {% endfor %}
     </tbody>
  </table>
     
       
              {% trans with {'%cdate%': "now"|date('d.m.y'),'%ctime%':"now"| date('H:i')  } %}report has been made at %cdate% %ctime%{% endtrans %}
{% endblock %}

{% block stylesheets %}
{% endblock %}


{% block context %}
    <a onclick="window.print()"> <span class="glyphicon glyphicon-print"></span> {% trans %}action.print{% endtrans %}</a><br>
    <a href='{{ path("update_case",{id:fall.getCaseId})}}'> <span class="glyphicon glyphicon-pencil"></span> {% trans %}action.update.case{% endtrans %}</a><br>
    <a href='{{ path("download_case_word",{id:fall.getCaseId})}}'> <span class="glyphicon glyphicon-download"></span> {% trans %}action.download.word.case{% endtrans %}</a><br>
{% endblock %}
