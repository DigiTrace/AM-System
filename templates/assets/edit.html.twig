{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_3_layout.html.twig' %} 

{% block content1 %}
    {# <div class="wrapper">
        <div class="container" > #}
            <h2>{{ 'asset.edit.header' | trans({'%asset%': asset.getBarcode })}}</h2>

            {{ include('messages.html.twig') }}
        
            {{ form_start(form) }}
            <div class="row">
                <div class="col-lg-4 col-xs-12">
                    {{ form_row(form.name) }}
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6">
                    {{ form_row(form.usage) }}
                </div>
                <div class="col-lg-6">
                    {{ form_row(form.note) }}
                </div>
            </div>

            {%  if asset.isDrive %}
            <div class="divider">{{ 'asset.edit.drive' | trans}}</div>

            {# drive form #}
            <div class="row">
                <div class="col-lg-3 col-xs-6">
                    {{ form_row(form.drive.type) }}
                    {{ form_row(form.drive.manufacturer) }}
                </div>

                <div class="col-lg-3 col-xs-6">
                    {{ form_row(form.drive.formFactor) }}
                    {{ form_row(form.drive.model) }}
                </div>

                <div class="col-lg-3 col-xs-6">
                    <div class="row">
                        <div class="col-lg-4">
                            {{ form_row(form.drive.size_choice) }}
                        </div>
                        <div class="col-lg-8">
                            {{ form_row(form.drive.size) }}
                        </div>
                    </div>
                    {{ form_row(form.drive.serialNumber) }}
                </div>

                <div class="col-lg-3 col-xs-6">
                    {{ form_row(form.drive.connector) }}
                    {{ form_row(form.drive.productNumber) }}
                </div>
            </div>
            {%  endif %}

            <div class="form-footer-rtl">
                {{ form_widget(form.save) }}
            </div>

            {{ form_end(form) }}
        {# </div>
    </div> #}
    
{% endblock %}

{% block stylesheets %}
{% endblock %}
