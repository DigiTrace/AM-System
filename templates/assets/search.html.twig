{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_3_layout.html.twig' %} 
{% block content1 %}
    {# <div class="wrapper">
         <div class="container" > #}
            <div class="row">
                <div class="col-lg-4"> 
                    <h2>{{ 'asset.search.page.header' | trans}}</h2>
                </div>
                <div class="col-lg-8" style="margin-top:7px">
                    {{ form_start(form) }}
                    {{ form_row(form.search) }}
                    {{ form_row(form.limit) }}
                    {{ form_row(form.eas) }}
                    {{ form_end(form) }}
                </div>
            </div>

            {{ include('messages.html.twig') }}

            {# Include extended search form#}
            <div id="eas_form_container" style="display: none;">
                {{ include('assets/extended_asset_search_form.html.twig', {
                    search_form: 'search_form', 
                    regex_single_match: regex_single_match, 
                    regex_multiple_match: regex_multiple_match
                }) }}
            </div>

   
    <table class="table">
        
    {% if pagination.getDirection == "desc" %} {% set arrow = '<span class="glyphicon glyphicon-arrow-down"></span>' %} 
        {% elseif pagination.getDirection == "asc" %}  {% set arrow = '<span class="glyphicon glyphicon-arrow-up"></span>' %}  
    {% endif %}
        
    <thead>
      <tr>
        <th class="col-md-2 col-sm-2">{{ knp_pagination_sortable(pagination,'desc.oid'|trans , 'asset.barcode_id') }}
            {% if pagination.isSorted('asset.barcode_id') %}
            {{ arrow | raw}}
            {% endif %}
        </th>
        <!--<th class="col-md-2 col-sm-2">{{ 'desc.category' | trans }}</th>-->
        <th class="col-md-2 col-sm-2" >{{ knp_pagination_sortable(pagination, 'desc.category'|trans, 'asset.kategorie_id') }} 
            {% if pagination.isSorted('asset.kategorie_id') %}
            {{ arrow | raw}}
            {% endif %}
        </th>
        <th class="col-md-7 col-sm-7">{{ knp_pagination_sortable(pagination, 'desc.name'|trans, 'asset.name') }} 
            {% if pagination.isSorted('asset.name') %}
            {{ arrow | raw}}
            {% endif %}
        </th>
        <th class="col-md-1 col-sm-1">{{ 'availability' | trans }}</th>
      </tr>
    </thead>
    <tbody>
      {% for asset in pagination %}
        
        {% if asset.isEditable == false %}
        <tr class="active">
            <td  style='font-family: courier;font-size: large'><s>{{ asset.getBarcode }}</s></td>
        {% else %}
        <tr>
            <td  style='font-family: courier;font-size: large'>{{ asset.getBarcode }}</td>
        {% endif %}
            
            <td  >{{ asset.getCategory | trans }}</td>
        
            <td><a href="{{ path('details_asset', {'id': asset.getBarcode}) }}">{{ asset.getName }} <a/></td>
              
        
        {% if asset.reservedBy != null %}
            <td> <span class="glyphicon glyphicon-alert"></span> {% trans with {'%user%':asset.reservedBy.getFullname} %}reserved from %user%{% endtrans %}</td>
        {% elseif asset.isEditable == false %}
            <td> <span class="glyphicon glyphicon-remove"></span> </td>
        {% else %}
            <td> <span class="glyphicon glyphicon-ok"></span> </td>
        {% endif %}
      </tr>
      {% endfor %}
   </tbody>
</table>
   
   
   
   
   {# total items count #}
<div class="count">
    {{ pagination.getTotalItemCount }} {{ 'entrys.found' | trans }}
</div>

{# display navigation #}
<div class="navigation">
    {{ knp_pagination_render(pagination) }}
</div>

{% endblock %}



{% block context %}
    <a href="{{ path("add_asset") }}"><span class="glyphicon glyphicon-pencil"></span> {{ 'action.add.object' | trans }}</a><br>
    <a href="{{ path("eas_faq") }}"><span class="glyphicon glyphicon-question-sign"></span> {{ 'action.object.faq.search' | trans }}</a> <br>
    <a href='{{ path("select_new_status_for_multiple_objects")}}'> <span class="glyphicon glyphicon-pencil"></span> {{ 'action.chosen.object.change' | trans }}</a><br>
      
{% endblock %}
