        </div>
        <div class="es-input-cell">
            <input class="es-input form-control" type="text" name="connector" id="es_connector"> 
        </div>

        <input type="submit" hidden />
    </div>
    <div class="es-footer">
        <button type="button" class="btn-primary btn" id="es_add_query">{{ 'es.form.add_query'| trans }}</button>
        <button type="submit" class="btn-default btn">{{ 'es.form.search'| trans }}</button>
        <button type="button" class="btn-default btn" onclick="$('#es_form_container').slideToggle(250)" >{{ 'es.form.hide'| trans }}</button>
    </div>
