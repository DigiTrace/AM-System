            </label>
            <label class="btn btn-default es-operator-btn" data-toggle="tooltip" data-placement="top" title="{{ 'es.operator.any'|trans}}">
                <input type="radio" name="product_number.operator" value="*" > ✓
            </label>
            <label class="btn btn-default es-operator-btn" data-toggle="tooltip" data-placement="top" title="{{ 'es.operator.none'|trans}}">
                <input type="radio" name="product_number.operator" value="-" > ✕
