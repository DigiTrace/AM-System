            </label>
            <label class="btn btn-default es-operator-btn" data-toggle="tooltip" data-placement="top" title="{{ 'es.operator.none'|trans}}">
                <input type="radio" name="serial_number.operator" value="-" > ✕
            </label>
        </div>
        <div class="es-input-cell">
            <input class="es-input form-control" type="text" name="serial_number" id="es_serial_number"> 
