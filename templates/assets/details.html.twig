{% extends 'base.html.twig' %}

{# Main content block #}
{% block content1 %}
 
    {# Caption #}
    <h2>{{ 'asset.details.page.header' | trans }} {{ asset.getCategory | trans }}: {{ id }} </h2>
    {# Alert messages / flashes #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">
                {{ message |trans }}
            </div>
        {% endfor %}
    {% endfor %}
    
    {# Asset details #}
    <div class="container-fluid" >
        <div class="row">
            
            {# Picture #}
            <div class="col-sm-5 col-xs-8 col-xs-offset-2 col-sm-offset-0" style="align:center" >
                {% if asset.getPicture != null %}
                <img  src="data:image/jpg;base64,{{ asset.getPicture }}"  class="img-thumbnail" style="max-height: 400px;display:block;margin-left: auto;margin-right:auto;" >
                {% elseif asset.getPicturePath != null  %}
                    <img  src="/uploads/pic/{{ asset.getPicturePath }}"  class="img-thumbnail" style="max-height: 400px;display:block;margin-left: auto;margin-right:auto;" >
                {% else %}
                <img  src="{{asset('img/no_image.jpeg')}}"  class="img-thumbnail" style="max-height: 400px;display:block;margin-left: auto;margin-right:auto;" >
                {% endif %}
            </div>
            
            {# State #}
            <div class="col-sm-7 col-xs-12" id="currentstatus" >
                <div class="panel panel-default">
                    <div class="panel-heading">
                        {{ 'currentstatus' | trans }}:
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-xs-12">
                                <dl>
                                   <dt>{{ 'desc.name' | trans }}</dt>
                                    <dd id="name">{{ asset.getName }}</dd>
                                </dl>

                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xs-4">
                                <dl>
                                   <dt>{{ 'desc.category' | trans }}</dt>
                                   <dd id="category">{{ asset.getCategory | trans  }}</dd>
                                </dl>
                            </div>
                            <div class="col-xs-7">
                                <dl>
                                   <dt>{{ 'desc.container' | trans }}</dt>
                                   <dd id="location">
                                    {% if asset.getLocation == null %}
                                        /
                                    {% else %}
                                        <a href='{{ path('details_asset', {'id': asset.getLocation.getBarcode}) }}' >{{ asset.getLocation.getBarcode }} | {{ asset.getLocation.getName }} </a></td>
                                    {% endif %}
                                   </dd>
                                </dl>
                             </div>
                        </div>
                        <div class="row">
                            <div class="col-xs-4">
                                <dl>
                                   <dt>{{ 'desc.reserved' | trans }}</dt>
                                   <dd id="reserved">
                                    {% if asset.getReservedBy == null %}
                                        /
                                    {% else %}
                                        {{ asset.getReservedBy.getFullname }}
                                    {% endif %}
                                   </dd>
                                </dl>
                            </div>
                            <div class="col-xs-6">
                                <dl>
                                   <dt>{{ 'desc.case' | trans }}</dt>
                                   <dd id="case"> 
                                    {% if asset.getCase == null %}
                                        /
                                    {% else %}

                                       <a href="{{ path('detail_case', {'id': asset.getCase.getCaseId }) }}">
                                            {{ asset.getCase.getCaseId }} | {{ asset.getCase.getDescription | slice(0,60) }}... 
                                       </a>
                                       
                                       {% if asset.getCase.getSecrecy != ""%}
                                           <br> <span 
                                            {% if asset.getCase.getSecrecy == "DOS_PUBLIC"%}
                                                class="label label-success"
                                            {% elseif asset.getCase.getSecrecy == "DOS_INTERNAL"%}
                                                class="label label-primary"
                                            {% elseif asset.getCase.getSecrecy == "DOS_CONFIDENTIAL"%}
                                                class="label label-warning"
                                            {% elseif asset.getCase.getSecrecy == "DOS_SECRET"%}
                                                class="label label-danger"
                                           {% endif %}
                                           >
                                            {{ asset.getCase.getSecrecy | trans}}   
                                           </span>
                                       {% endif %}
                                    {% endif %}
                                   </dd>
                                </dl>
                             </div>
                        </div>
                        <div class="row">
                            {% if asset.isHddImageTarget %}
                            <div class="col-xs-4">
                                <dl>
                                   <dt>{{ 'desc.imaged' | trans }}</dt>
                                   <dd id="images">
                                       {% if asset.getImages.isEmpty %}
                                           /
                                        {% else %}
                                            {% for image in asset.getImages %}
                                                <a href='{{ path("details_asset",{id:image.getBarcode})}}'>{{image.getBarcode}} | {{image.getName | u.truncate(10)}}</a><br>
                                            {% endfor %}
                                        {% endif %}
                                   </dd>
                                </dl>
                            </div>
                            {% endif %}
                            {% if asset.isHddImageSource %}
                            <div class="col-xs-4">
                                <dl>
                                   <dt>{{ 'desc.imaged.by' | trans }}</dt>
                                   <dd id="image_locations">
                                       {% if asset.getHDDs.isEmpty %}
                                           /
                                        {% else %}
                                            {% for image in asset.getHDDs %}
                                                <a href='{{ path("details_asset",{id:image.getBarcode})}}'>{{image.getBarcode}} | {{image.getName | u.truncate(10)}}</a><br>
                                            {% endfor %}
                                        {% endif %}
                                   </dd>
                                </dl>
                            </div>
                            {% endif %}
                            <div class="col-xs-6">
                                <dl>
                                   <dt>{{ 'desc.luser' | trans }}</dt>
                                   <dd id="last_action_user"> 
                                        {{ asset.getModifiedBy.getFullname }}
                                   </dd>
                                </dl>
                            </div>
                        </div>
                        <div class="row">

                        </div>
                        <div class="row">
                             <div class="col-xs-12">
                                <dl>
                                   <dt>{{ 'desc.last.action.done.registered' | trans }}</dt>
                                   <dd id="last_action_timestamp">
                                        {{ asset.getLastUpdatePerformedOn|date('d.m.y H:i')}} / {{ asset.getLastUpdatedOn|date('d.m.y H:i')}}
                                   </dd>
                                </dl>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12">
                                 <dl>
                                   <dt>{{ 'desc.status' | trans }}</dt>
                                   <dd id="state">{{ asset.getState | trans }}</dd>
                                </dl>

                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <dl>
                                    <dt>{{ 'desc.usage' | trans }}</dt>
                                    <dd id="description"> 
                                        {% if asset.getUsage == null %}
                                          /
                                        {% else %}
                                            {{ asset.getUsage | nl2br | barcodelinker | caselinker | raw }}
                                        {% endif %}
                                    </dd>
                                 </dl>
                            </div>
                            <div class="col-sm-6">
                                <dl>
                                    <dt>{{ 'desc.additional.usage' | trans }}</dt>
                                    <dd id="note"> 
                                        {% if asset.getNote == null %}
                                          /
                                        {% else %}
                                            {{ asset.getNote | nl2br | barcodelinker | raw}}
                                        {% endif %}
                                    </dd>
                                 </dl>
                            </div>
                        </div>

                    </div>
                </div>
            </div>  
        </div>
           
        {# Additional information #}              
        <div class="panel panel-default">
            <div class="panel-heading">
                {{ 'additional.information' | trans }}:
                <a href="#additionalinformation" data-toggle="collapse" class="btn btn-xs pull-right hidden-print">
                    <span class="glyphicon glyphicon-menu-hamburger "></span>
                </a>

            </div>
            <div id="additionalinformation" class="panel-collapse collapse " >

               <div class="panel-body">
                {% set drive = asset.getDrive %}
                {% if drive != null %}
                    <div class="panel panel-default" id="hdd_info">
                        <div class="panel-heading">
                            {{ 'hddinfos' | trans }}:
                        </div>
                        <div class="panel-body" id="hddinfo">
                            <div class="row" >
                                <div class="col-sm-3 col-xs-6">
                                    <dl>
                                       <dt>{{ 'desc.type' | trans }}</dt>
                                       <dd id="drive_type">{{ drive.getType}}</dd>
                                    </dl>
                                </div>
                                <div class="col-sm-3 col-xs-6">
                                    <dl>
                                       <dt>{{ 'desc.formfactor' | trans }}</dt>
                                       <dd id="form_factor">{{ drive.getFormFactor }}</dd>
                                    </dl>
                                </div>
                                <div class="col-sm-3 col-xs-6">
                                    <dl>
                                       <dt>{{ 'desc.size' | trans }}</dt>
                                       <dd id="size">{{ drive.getSize }}{% if drive.getSize %}{{ 'desc.size.postfix' | trans }}{% endif %}</dd> 
                                    </dl>
                                </div>
                                <div class="col-sm-3 col-xs-6">
                                    <dl>
                                       <dt>{{ 'desc.producer' | trans }}</dt>
                                       <dd id="producer">{{ drive.getManufacturer}}</dd>
                                    </dl>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-3 col-xs-6">
                                    <dl>
                                       <dt>{{ 'desc.modell' | trans }}</dt>
                                       <dd id="modell">{{ drive.getModel}}</dd>
                                    </dl>
                                </div>
                                <div class="col-sm-3 col-xs-6">
                                    <dl>
                                       <dt>{{ 'desc.sn' | trans }}</dt>
                                       <dd id="sn">{{ drive.getSerialNumber}}</dd>
                                    </dl>
                                </div>
                                <div class="col-sm-3 col-xs-6">
                                    <dl>
                                       <dt>{{ 'desc.pn' | trans }}</dt>
                                       <dd id="pn">{{ drive.getProductNumber}}</dd>
                                    </dl>
                                </div>
                                <div class="col-sm-3 col-xs-6">
                                    <dl>
                                       <dt>{{ 'desc.connection' | trans }}</dt>
                                       <dd id="connection">{{ drive.getConnector}}</dd>
                                    </dl>
                                </div>
                            </div>         
                        </div>
                    </div>  
                {% endif %}
    
                {# Storage information #}
                {% if (asset.isStorage)%}
                    <div class="panel panel-default" id="container_info">
                        <div class="panel-heading">
                            {{ 'currentinventory' | trans }}:
                        </div>
                    
                    {% if asset.getStorage.isEmpty %}
                        <div class="panel-body">
                                {{ 'message.no.objects.in.container' | trans }}
                        </div>
                    {% else %}
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>{{ 'case_id' | trans }}</th>
                                    <th>{{ 'desc.oid' | trans }}</th>
                                    <th>{{ 'desc.name' | trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for stored_object in asset.getStorage %}
                                <tr >
                                    <td>
                                    {% if stored_object.getCase != null %}
                                        <a href="{{ path('detail_case', {'id': stored_object.getCase.getCaseId}) }}">
                                        {{ stored_object.getCase.getCaseId }}
                                        </a>
                                    {% else %}
                                        -
                                    {% endif %}
                                    </td> 
                                    
                                    <td style='font-family: courier;font-size: large'>
                                        <a href="{{ path('details_asset', {'id': stored_object.getBarcode}) }}">
                                        {{ stored_object.getBarcode }}
                                        </a>
                                    </td>
                                    <td>
                                        <a href="{{ path('details_asset', {'id': stored_object.getBarcode}) }}">
                                        {{ stored_object.getName }}
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table> 
                    {% endif %}
                    </div>     
                {% endif %}
                
                {% if asset.isHddImageSource %}
                    <div class="panel panel-default" id="image_locations_info">
                        <div class="panel-heading">
                            {{ 'currentimagelocations' | trans }}:
                        </div>

                    {% if asset.getHDDs.isEmpty %}
                        <div class="panel-body">
                                {{ 'message.exhibit.asset.has.no.other.images' | trans }}
                        </div>
                    {% else %}
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>{{ 'desc.oid' | trans }}</th>
                                    <th>{{ 'desc.name' | trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for hdd in asset.getHDDs %} 
                                <tr>
                                    <td style='font-family: courier;font-size: large'>
                                        <a href="{{ path('details_asset', {'id': hdd.getBarcode}) }}">
                                        {{ hdd.getBarcode }}
                                        </a>
                                    </td>
                                    <td>
                                        <a href="{{ path('details_asset', {'id': hdd.getBarcode}) }}">
                                        {{ hdd.getName }}
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                         </table> 
                    {% endif %}
                    </div>     
                {% endif %}
                
                {% if asset.isHddImageTarget %}
                    <div class="panel panel-default" id="images_info">
                        <div class="panel-heading">
                            {{ 'currentsavedexhibithdd' | trans }}:
                        </div>
                    
                    {% if asset.getImages.isEmpty %}
                        <div class="panel-body">
                            {{ 'message.hdd.asset.has.no.saved.exhibit.hdd.objects' | trans }}
                        </div>
                    {% else %}
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>{{ 'desc.oid' | trans }}</th>
                                    <th>{{ 'desc.name' | trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for exhibit in asset.getImages %}
                                <tr >
                                    <td style='font-family: courier;font-size: large'>
                                        <a href="{{ path('details_asset', {'id': exhibit.getBarcode}) }}">
                                        {{ exhibit.getBarcode }}
                                        </a>
                                    </td>
                                    <td>
                                        <a href="{{ path('details_asset', {'id': exhibit.getBarcode}) }}">
                                        {{ exhibit.getName }}
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table> 
                    {% endif %}
                    </div>     
                {% endif %}
                </div>    
            </div>
        </div>
    </div>
     
                    
 {% endblock %}

{# Asset history #}
{% block content2 %}
    <h2>{{ 'history' | trans }}</h2>       
        <div class="container-fluid" id="history">            
        {% if asset.getHistories.isEmpty %}
            <p>{{ 'message.no.history.available' | trans }}</p>   
        {% else %}    
            <div class="row"> 
                <div class="col-sm-12">
                <table class="table">
                    <thead>
                        <tr>
                            <th>{{ 'desc.action.done' | trans }}</th>
                            <th>{{ 'desc.action.registered' | trans }}</th>
                            <th>{{ 'desc.status' | trans }}</th>
                            <th>{{ 'desc.usage' | trans }}</th>
                            <th>{{ 'desc.case' | trans }}</th>
                            <th>{{ 'desc.container' | trans }}</th>
                            <th>{{ 'desc.reserved' | trans }}</th>
                            {% if asset.isHddImageTarget %}
                            <th>{{ 'desc.imaged' | trans }}</th>
                            {% endif %}
                            <th>{{ 'desc.user' | trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for entry in asset.getHistories %}
                        
                        <tr {{ entry.isSystemAction ? 'class="active"' : ''}}>
                            <td>{{ entry.getLastUpdatePerformedOn|date('d.m.y H:i')}}</td>
                            <td>{{ entry.getLastUpdatedOn|date('d.m.y H:i')}}</td>
                            <td>{{ entry.getState | trans  }}</td>
                            <td>{{ entry.getUsage | nl2br | barcodelinker | raw}}</td>

                            {# Ausgabe des zugeteilten Falles #}
                            {% if entry.getCase != null %}
                            <td><a href='{{ path("detail_case",{id:entry.getCase.getCaseId})}}'>{{ entry.getCase.getCaseId }} </a></td>
                            {% else %}
                            <td> / </td>
                            {% endif %}

                            {# Ausgabe des Standorts #}
                            {% if entry.getLocation != null %}
                            <td> <a href='{{ path("details_asset",{id:entry.getLocation.getBarcode})}}'>{{ entry.getLocation }} | {{ entry.getLocation.getName}} </a></td>
                            {% else %}
                            <td> / </td>
                            {% endif %}

                            {# Reserviert von Spalte #}
                            {% if entry.getReservedBy != null %}
                            <td> {{ entry.getReservedBy }} </td>
                            {% else %}
                            <td> / </td>
                            {% endif %}
                                
                            {# Reserviert von Spalte #}
                            {% if asset.isHddImageTarget %}
                                {% if not entry.getImages.isEmpty %}
                                <td>
                                {% for image in entry.getImages %}
                                    <a href='{{ path("details_asset",{id:image.getBarcode})}}'>{{image.getBarcode}}</a><br>
                                {% endfor %}
                                </td>
                                {% else %}
                                <td> / </td>
                                {% endif %}
                            {% endif %}

                            <td>{{ entry.getModifiedBy.getFullname }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                </div>
            </div>
            
                
            {% endif %}
            </div>
            {% set currentdate = "now"|date('d.m.y') %}
            {% set currenttime = "now"| date('H:i') %}
            
            
            {% trans with {'%cdate%': "now"|date('d.m.y'),'%ctime%':"now"| date('H:i')  } %}report has been made at %cdate% %ctime%{% endtrans %}
{% endblock %}

{% block stylesheets %}
{% endblock %}


{% block context %}    
    <a onclick="window.print()"> <span class="glyphicon glyphicon-print"></span> {{ 'action.print' | trans }}</a><br>
     {# Wenn das Objekt NICHT vernichtet oder verloren worden sind #}
    {% if asset.getState != AssetState.Destroyed and asset.getState != AssetState.Lost %}
        
        {% if asset.getState != AssetState.Destroyed  and asset.getCategory == AssetCategory.Hdd %}
        <a href='{{ path("clean_asset",{id:id})}}'> <span class="glyphicon glyphicon-erase"></span> {{ 'action.cleaned' | trans }}</a><br>
        {% endif %}
        
        {% if asset.getCategory == AssetCategory.Hdd %}
            <a href='{{ path("neutralize_asset",{id:id})}}'> <span class="glyphicon glyphicon-erase"></span> {{ 'action.neutralise' | trans }}</a><br>
            
        {% endif %}
        
        
        {% if asset.getCategory == AssetCategory.Hdd or
              asset.getCategory == AssetCategory.ExhibitHdd  %}
            <a href='{{ path("save_image_on_drive_asset",{id:id})}}'> <span class="glyphicon glyphicon-import"></span> {{ 'action.add.image' | trans }}</a><br>
        {% endif %}
                
        
        <a href='{{ path("destroy_asset",{id:id})}}'> <span class="glyphicon glyphicon-fire"></span> {{ 'action.destroyed' | trans }}</a><br>

        <a href='{{ path("handover_asset",{id:id})}}'> <span class="glyphicon glyphicon-send"></span> {{ 'action.handover.person' | trans }}</a><br>

        <a href='{{ path("lost_asset",{id:id})}}'> <span class="glyphicon glyphicon-thumbs-down"></span> {{ 'action.lost' | trans }}</a><br>

        <a href='{{ path("use_asset",{id:id})}}'> <span class="glyphicon glyphicon-console"></span> {{ 'action.used' | trans }}</a><br>


        {# Bei der Reservierung wird nicht auf den State ueberprueft #}
        {% if asset.getReservedBy == null %}
            <a href='{{ path("reserve_asset",{id:id})}}'> <span class="glyphicon glyphicon-lock"></span> {{ 'action.reserved' | trans }}</a><br>
        {% else %}
            <a href='{{ path("unreserve_asset",{id:id})}}'> <span class="glyphicon glyphicon-edit"></span> {{ 'action.unbind.reserved' | trans }}</a><br>
        {% endif %}
        
        
        
        {% if asset.getLocation == null %}
            <a href='{{ path("store_asset",{id:id})}}'> <span class="glyphicon glyphicon-briefcase"></span> {{ 'action.stored.in.container' | trans }}</a><br>
        {% else %}
            <a href='{{ path("store_asset",{id:id})}}'> <span class="glyphicon glyphicon-briefcase"></span> {{ 'action.stored.in.container.alternativ' | trans }}</a><br>
            <a href='{{ path("pull_out_asset",{id:id})}}'> <span class="glyphicon glyphicon-briefcase"></span> {{ 'action.pulled.out.of.container' | trans }}</a><br>
        {% endif %}
          
        
        {% if asset.getCase != null %}
           {% if asset.getCategory != AssetCategory.Record %} 
                <a href='{{ path("remove_case_asset",{id:id})}}'> <span class="glyphicon glyphicon-export"></span> {{ 'action.removed.from.case' | trans }}</a><br>
           {% endif %}
        {% else %}
          <a href='{{ path("assign_case_asset",{id:id})}}'> <span class="glyphicon glyphicon-import"></span> {{ 'action.added.to.case' | trans }}</a><br>
        {% endif %}

        <a href='{{ path("edit_asset",{id:id})}}'> <span class="glyphicon glyphicon-edit"></span> {{ 'action.edit' | trans }}</a><br>
        {% if asset.getPicture == null and asset.getPicturePath == null %}
        <a href='{{ path("upload_picture_asset",{id:id})}}'> <span class="glyphicon glyphicon-upload"></span> {{ 'action.upload.image' | trans }}</a><br>
        {% endif %}
        
                
     {% endif %}
       
{% endblock %}

