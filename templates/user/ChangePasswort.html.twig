{% extends 'base.html.twig' %}
{% form_theme changePWform 'bootstrap_3_layout.html.twig' %} 


{% block content1 %}

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">
                    {{ message |trans }}
                </div>
            {% endfor %}
        {% endfor %}
    

    

        {{ form_start(changePWform) }}
    
    

    
             <div class="row">
                 <div class='col-sm-4'>
                     <div id="case_id_field">
                    {{ form_label(changePWform.oldPW) }}
                    {{ form_widget(changePWform.oldPW) }}
                    {{ form_errors(changePWform.oldPW) }}
                    <span class="help-block"></span>
                     </div>
                </div>                 
             </div>
                
             <div class="row">
                 <div class='col-sm-4'>
                     {{ form_label(changePWform.newPW) }}
                    {{ form_errors(changePWform.newPW) }}
                    {{ form_widget(changePWform.newPW) }}
                    <span class="help-block"></span>
                </div>
                
                 
             </div>
                 
             <div class="row">
                <div class='col-sm-4'>
                    {{ form_widget(changePWform.save) }}
                   
                </div>
             </div>        
    {{ form_widget(changePWform) }}

    {{ form_end(changePWform) }}


{% endblock %}


{% block context %}
{{ include('admin/context.html.twig') }}
{% endblock %}
