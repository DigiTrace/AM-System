{% extends 'base.html.twig' %}
{% block content1 %}
    <h2>{{ 'user.page.password' | trans }} </h2>
    <div id="alert-anchor">

    <h3>{{ 'user.form.change_password' | trans }}</h3>
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">
                {{ message |trans }}
            </div>
            {% endfor %}
        {% endfor %}
    </div>


    {% form_theme form 'bootstrap_3_layout.html.twig' %} 
    {{ form_start(form) }}
        <div class="row">
            <div class='col-sm-12 col-md-6'>
                {{ form_label(form.old_password) }}
                {{ form_widget(form.old_password) }}
                {{ form_errors(form.old_password) }}
                <span class="help-block"></span>
            </div>
        </div>

        <div class="row">
            <div class='col-sm-12 col-md-6'>
                {{ form_label(form.new_password) }}
                {{ form_widget(form.new_password) }}
                {{ form_errors(form.new_password) }}
                <span class="help-block"></span>
            </div>
            
        </div>

        <div class="row">
            <div class='col-sm-12 col-md-6'>
                {{ form_label(form.new_password_repeat) }}
                {{ form_widget(form.new_password_repeat) }}
                {{ form_errors(form.new_password_repeat) }}
                <span class="help-block"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                {{ form_widget(form.save) }}
            </div>
        </div>        
    {{ form_widget(form) }}
    {{ form_end(form) }}

{% endblock %}

{% block context %}
{{ include('admin/context.html.twig') }}
{% endblock %}
